{
  "window": {
    "width": 1280,
    "height": 960
  },
  "background": {
    "color": "#000000"
  },
  "square": {
    "width": 400,
    "height": 400,
    "speed": 400,
    "acceleration": 650,
    "friction": 4200,
    "color": "#7FFFD4",
    "outline": 3,
    "idle_alpha": 0.5,
    "shrink_rate": 1,
    "min_size": 10
  },
  // Space, either trigger or any face button closes the frame in around the
  // ball and keeps it there. The ball stops where it is and rides the frame;
  // hold on too long and the grip takes the whole run, not just a hit.
  "squeeze": {
    "close": 0.25,  // seconds for the walls to come all the way in, and to open back out
    "warn": 2.4,    // seconds the ball takes it before it starts to shake
    "crush": 1.8,   // seconds of shaking after that before the grip has it
    "recharge": 6,          // seconds the bar takes to fill before it can grab again
    "recharge_growth": 1.8, // how much dearer each fill makes the next; 1.0 never changes
    "bar_width": 160        // how wide the bar is drawn, centered along the top
  },
  "circle": {
    "diameter": 35,
    "speed": 340,
    "color": "#FF1493",
    "start_x": 0.5,
    "start_y": 0.65,
    "growth_per_diamond": 1.1,
    "collider_scale": 0.75
  },
  "star": {
    "size": 14,
    "color": "#FFD13B",
    "gap_min": 12,
    "gap_max": 20,
    "edge_margin": 48,
    "pause": 0.6,
    "seek_speed": 0.8,
    "hold": 3,
    "linger": 3,       // seconds the ring stays on after the release, breaking hazards
    "spin_speed": 1.0,
    "unlock_diamonds": 3
  },
  "diamond": {
    "edge_margin_x": 60,
    "edge_margin_y": 78
  },
  "hexagon": {
    "size": 14,
    "color": "#7FFFD4",
    "spin_speed": 0.12,
    "grow_rate": 120,
    "gap_min": 22,
    "gap_max": 40,
    "unlock_diamonds": 7
  },
  "moving_hazard": {
    "size": 16,
    "color": "#FF2400",
    "speed": 660,
    "warn": 2,
    "gap_min": 7,
    "gap_max": 15,
    "unlock_diamonds": 8
  },
  "still_hazard": {
    "size": 16,
    "color": "#FF2400",
    "gap_min": 5,
    "gap_max": 11,
    "arm": 2,
    "life": 4,
    "unlock_diamonds": 5
  },
  // The tube the game is shown through. All of it is presentation: it changes
  // how the game looks, never where anything is or what it touches. R reloads
  // the file, so these can be tuned with the game running.
  "crt": {
    "enabled": true,     // false skips the whole pass and shows a flat picture
    "curvature": 0,      // how far the glass bows; 0 is a flat panel, 0.25 a fishbowl
    "scanlines": 0.05,   // how dark the gaps between the lines go; 0 is none
    "line_gap": 1,       // game pixels from one scanline to the next; 2 is the tightest that shows
    "vignette": 0.35,    // how far the corners fall away into the dark
    "glow": 1,           // phosphor bloom off the bright shapes; 1 is the most there is
    "aberration": 0.005  // red/blue split, as a fraction of the picture's width
  }
}
