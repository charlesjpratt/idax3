  // The tube the game is shown through. All of it is presentation: it changes
  // how the game looks, never where anything is or what it touches. R reloads
  // the file, so these can be tuned with the game running.
  "crt": {
    "enabled": false,    // false skips the whole pass and shows a flat picture
    "curvature": 0.03,   // how far the glass bows; 0 is a flat panel, 0.25 a fishbowl
    "scanlines": 0.1,    // how dark the gaps between the lines go; 0 is none
    "line_gap": 3,       // game pixels from one scanline to the next
    "vignette": 0.35,    // how far the corners fall away into the dark
    "glow": 0.3,         // phosphor bloom off the bright shapes; 1 is the most there is
    "aberration": 0.005  // red/blue split, as a fraction of the picture's width
  }
}
